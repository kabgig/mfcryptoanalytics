{
  "name": "mfcryptoanalytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --import ./scripts/test/alias-hooks.mjs --test scripts/test/*.test.ts",
    "test:integration": "node --env-file=.env.local --experimental-strip-types --import ./scripts/test/alias-hooks.mjs scripts/test/softDelete.integration.ts",
    "test:ui": "node --env-file=.env.local scripts/test/softDelete.ui.mjs",
    "test:ui:spot": "node --env-file=.env.local scripts/test/spot.ui.mjs",
    "test:ui:journal": "node --env-file=.env.local scripts/test/journal.ui.mjs",
    "test:ui:overrides": "node --env-file=.env.local scripts/test/overrides.ui.mjs",
    "db:migrate": "dbmate --env-file .env.local up",
    "db:rollback": "dbmate --env-file .env.local down",
    "db:status": "dbmate --env-file .env.local status"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@neondatabase/serverless": "^1.1.0",
    "@reown/appkit": "^1.8.19",
    "@reown/appkit-adapter-wagmi": "^1.8.19",
    "@tanstack/react-query": "^5.99.2",
    "@types/three": "^0.184.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.48.4",
    "wagmi": "^3.6.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
